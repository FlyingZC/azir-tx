# 仅为部署模板。先替换真实地址、组 UUID、证书指纹和路径，再保存为私有 node.properties。
# peer 指纹必须是已授权叶证书 SHA-256 的 64 位小写十六进制，禁止首次连接自动信任。
format.version=1
node.id=node-a
node.directory=/var/lib/azir-wal/node-a
group.id=1a6b8f4a-d2d0-4335-b694-846b885ee921
group.voters=node-a,node-b,node-c
tls.peers=node-a,node-b,node-c
peer.node-a.address=wal-a.example.invalid:19001
peer.node-a.sha256=REPLACE_WITH_NODE_A_LEAF_SHA256
peer.node-b.address=wal-b.example.invalid:19001
peer.node-b.sha256=REPLACE_WITH_NODE_B_LEAF_SHA256
peer.node-c.address=wal-c.example.invalid:19001
peer.node-c.sha256=REPLACE_WITH_NODE_C_LEAF_SHA256
tls.identity=/etc/azir-wal/node-a.p12
tls.identity-password-env=AZIR_WAL_IDENTITY_PASSWORD
tls.truststore=/etc/azir-wal/raft-ca.p12
tls.trust-password-env=AZIR_WAL_RAFT_TRUST_PASSWORD

# 每个副本必须使用自己的 MySQL 存储；此处两个逻辑分片共用该副本一个控制池。
stores=local
store.local.jdbc-url=jdbc:mysql://mysql-a.example.invalid:3306/azir_wal_control
store.local.username-env=AZIR_WAL_MYSQL_USERNAME
store.local.password-env=AZIR_WAL_MYSQL_PASSWORD
store.local.truststore=/etc/azir-wal/mysql-ca.p12
store.local.trust-password-env=AZIR_WAL_MYSQL_TRUST_PASSWORD
shards=account,ledger
route.account=local
route.ledger=local
namespace.prefix=azw
namespace.max-generations=8
namespace.max-schemas=128
namespace.connections-per-shard=2

tx.max-active=4096
tx.max-write-keys=1024
tx.max-write-bytes=1048576
tx.queue-capacity=4096
tx.commit-batch-size=64
tx.batch-delay-ms=1
tx.max-wal-bytes=268435456
tx.max-memory-bytes=67108864
tx.timeout-ms=60000
tx.flush-batch-size=1024
tx.flush-interval-ms=1
tx.hot-cache-bytes=8388608
tx.max-materialization-lag=100000
backup.max-bytes=17179869184
backup.batch-keys=256
backup.batch-bytes=16777216
backup.timeout-ms=300000

# 已持久化的维护策略必须保持一致；不要通过修改默认值绕过策略校验。
maintenance.health.interval-ms=1000
maintenance.health.failures=3
maintenance.health.recoveries=3
maintenance.health.probe-ms=1000
maintenance.health.transfer-ms=10000
maintenance.gc.interval-ms=1000
maintenance.gc.key-limit=64
maintenance.gc.row-limit=1024
maintenance.gc.work-ms=100
maintenance.gc.stale-ms=15000
maintenance.snapshot.interval-ms=1000
maintenance.snapshot.entry-gap=10000
maintenance.snapshot.max-interval-ms=300000
maintenance.snapshot.log-high-water-bytes=268435456
maintenance.snapshot.preserve-entries=1024
maintenance.sample-ms=1000
maintenance.stale-ms=15000
maintenance.probe-ms=1000
transport.connections=64
transport.calls=32
transport.streams=8
transport.metadata-bytes=8192
transport.backlog=128
transport.handshake-ms=3000
transport.idle-ms=60000
transport.connection-age-ms=900000
health.address=127.0.0.1
health.port=18080
# 可选：显式填写实现 RatisNodeApplication 的可信公开类名；缺少此键仅启动副本及监控。
# application.class=com.example.AzirBusinessApplication
