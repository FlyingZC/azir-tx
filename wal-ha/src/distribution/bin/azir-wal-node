# Run one foreground process without evaluating JAVA_OPTS or configuration, forking a daemon, or killing other processes.
set -eu
umask 077
script_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd -P)
if [ -n "${JAVA_HOME:-}" ]; then
    java_bin="$JAVA_HOME/bin/java"
else
    java_bin=java
fi
heap=${AZIR_WAL_HEAP:-512m}
case "$heap" in
    256m|512m|1g|2g|4g|8g) ;;
    *) echo 'AZIR_WAL_HEAP must be one of: 256m 512m 1g 2g 4g 8g' >&2; exit 2 ;;
esac
# Set HTTP limits before JDK server initialization; validated configuration restricts the listener to loopback.
exec "$java_bin" "-Xmx$heap" -XX:MaxDirectMemorySize=128m -XX:+ExitOnOutOfMemoryError \
    --add-modules jdk.httpserver \
    -Djdk.httpserver.maxConnections=32 \
    -Dsun.net.httpserver.maxIdleConnections=8 \
    -Dsun.net.httpserver.maxReqHeaders=32 \
    -Dsun.net.httpserver.maxReqTime=5 \
    -Dsun.net.httpserver.maxRspTime=5 \
    -Dsun.net.httpserver.idleInterval=5 \
    -Dsun.net.httpserver.drainAmount=0 \
    -Dorg.slf4j.simpleLogger.defaultLogLevel=warn \
    -cp "$script_dir/../lib/*" com.flyingzc.azir.wal.ha.RatisNodeMain "$@"
